{
  "name": "Veritate 3B",
  "description": "Vanilla byte-level decoder at the 3B scale. Same canonical Veritate stack (GELU FFN, RMSNorm, learned pos-emb, tied LM head, vocab=256). Defaults enable activation checkpointing and 8-bit AdamW.",
  "kind": "trainer",
  "bench": true,
  "flow": [
    "scratch",
    "continue"
  ],
  "sizes": {
    "3b": {
      "layers": 32,
      "hidden": 2560,
      "ffn": 10240,
      "heads": 32,
      "params": 2516000000
    }
  },
  "defaults": {
    "size": "3b",
    "precision": "bf16",
    "version": "v1",
    "total_steps": 50000,
    "batch_size": 2,
    "seq": 1024,
    "n_chunks": 1,
    "bptt_window": 1,
    "base_lr": 0.00015,
    "min_lr": 1.5e-05,
    "warmup_steps": 2000,
    "lr_schedule": "cosine",
    "wsd_decay_frac": 0.1,
    "wsd_decay_kind": "sqrt",
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "label_smoothing": 0.0,
    "grad_clip": 1.0,
    "ckpt_every": 2500,
    "log_every": 25,
    "eval_every": 2500,
    "eval_iters": 8,
    "seed": 0,
    "use_act_ckpt": true,
    "use_8bit_adam": true,
    "qat_enabled": false
  }
}
