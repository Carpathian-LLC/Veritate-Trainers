{
  "name": "Veritate 1.3B (vanilla dense)",
  "description": "Vanilla byte-level decoder in the 1B-2B range. Same canonical Veritate stack (GELU FFN, RMSNorm, learned pos-emb, tied LM head, vocab=256). Defaults enable activation checkpointing and 8-bit AdamW for memory efficiency.",
  "kind": "trainer",
  "bench": true,
  "flow": [
    "scratch",
    "continue"
  ],
  "sizes": {
    "800m": {
      "layers": 28,
      "hidden": 1536,
      "ffn": 6144,
      "heads": 24,
      "params": 793000000
    },
    "1b3": {
      "layers": 24,
      "hidden": 2048,
      "ffn": 8192,
      "heads": 16,
      "params": 1210000000
    },
    "2b": {
      "layers": 24,
      "hidden": 2560,
      "ffn": 10240,
      "heads": 20,
      "params": 1888000000
    }
  },
  "defaults": {
    "size": "1b3",
    "precision": "bf16",
    "version": "v1",
    "total_steps": 40000,
    "batch_size": 4,
    "seq": 1024,
    "n_chunks": 1,
    "bptt_window": 1,
    "base_lr": 0.0002,
    "min_lr": 2e-05,
    "warmup_steps": 1500,
    "lr_schedule": "cosine",
    "wsd_decay_frac": 0.1,
    "wsd_decay_kind": "sqrt",
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "label_smoothing": 0.0,
    "grad_clip": 1.0,
    "ckpt_every": 2000,
    "log_every": 20,
    "eval_every": 2000,
    "eval_iters": 8,
    "seed": 0,
    "use_act_ckpt": true,
    "use_8bit_adam": true,
    "qat_enabled": false
  }
}
