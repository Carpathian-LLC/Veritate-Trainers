{
  "name": "Veritate MEGA (8-expert top-1 MoE)",
  "description": "MoE byte-level decoder. Each transformer block's FFN is replaced with N independent expert FFNs and a top-1 router; total parameter count scales with expert count while active parameters per byte stay near a single expert's footprint. Default corpus FineWeb. Top-1 routing only (matches v11 engine spec).",
  "kind": "trainer",
  "bench": true,
  "flow": [
    "scratch",
    "continue"
  ],
  "sizes": {
    "200m": { "layers": 12, "hidden":  512, "ffn": 2048, "heads":  8, "params":  200000000, "active_params":  90000000 },
    "850m": { "layers": 14, "hidden":  896, "ffn": 3584, "heads": 14, "params":  860000000, "active_params": 280000000 },
    "1b":   { "layers": 16, "hidden": 1024, "ffn": 4096, "heads": 16, "params": 1023000000, "active_params": 330000000 },
    "1b5":  { "layers": 20, "hidden": 1280, "ffn": 5120, "heads": 16, "params": 1500000000, "active_params": 470000000 }
  },
  "defaults": {
    "size": "1b",
    "precision": "bf16",
    "version": "v1",
    "corpus": "fineweb",
    "total_steps": 24000,
    "batch_size": 24,
    "seq": 1024,
    "n_experts": 8,
    "router_topk": 1,
    "router_aux_loss_coef": 0.01,
    "base_lr": 0.00025,
    "min_lr": 2.5e-05,
    "warmup_steps": 1500,
    "lr_schedule": "cosine",
    "wsd_decay_frac": 0.1,
    "wsd_decay_kind": "sqrt",
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "label_smoothing": 0.0,
    "grad_clip": 1.0,
    "ckpt_every": 1000,
    "log_every": 20,
    "eval_every": 1000,
    "eval_iters": 16,
    "seed": 0,
    "use_act_ckpt": false,
    "qat_enabled": false
  }
}
