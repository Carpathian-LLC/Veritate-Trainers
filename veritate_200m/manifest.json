{
  "name": "Veritate 200M",
  "description": "Vanilla byte-level decoder at the 200M scale. Same canonical Veritate stack (GELU FFN, RMSNorm, learned pos-emb, tied LM head, vocab=256). Defaults enable activation checkpointing and 8-bit AdamW.",
  "kind": "trainer",
  "bench": true,
  "flow": [
    "scratch",
    "continue"
  ],
  "sizes": {
    "200m": {
      "layers": 16,
      "hidden": 1024,
      "ffn": 4096,
      "heads": 16,
      "params": 202000000
    }
  },
  "defaults": {
    "size": "200m",
    "precision": "bf16",
    "version": "v1",
    "total_steps": 12000,
    "batch_size": 108,
    "seq": 1024,
    "n_chunks": 4,
    "bptt_window": 4,
    "base_lr": 0.00039,
    "min_lr": 3e-05,
    "warmup_steps": 360,
    "lr_schedule": "cosine",
    "wsd_decay_frac": 0.1,
    "wsd_decay_kind": "sqrt",
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "label_smoothing": 0.0,
    "grad_clip": 1.0,
    "ckpt_every": 1200,
    "log_every": 12,
    "eval_every": 600,
    "eval_iters": 16,
    "seed": 0,
    "use_act_ckpt": true,
    "qat_enabled": false
  }
}
