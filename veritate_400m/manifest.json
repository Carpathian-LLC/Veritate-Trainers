{
  "name": "Veritate 400M",
  "description": "Vanilla byte-level decoder at the 400M scale. Same canonical Veritate stack (GELU FFN, RMSNorm, learned pos-emb, tied LM head, vocab=256). Defaults enable activation checkpointing.",
  "kind": "trainer",
  "bench": true,
  "flow": [
    "scratch",
    "continue"
  ],
  "sizes": {
    "400m": {
      "layers": 24,
      "hidden": 1280,
      "ffn": 5120,
      "heads": 20,
      "params": 472000000
    }
  },
  "defaults": {
    "size": "400m",
    "precision": "bf16",
    "version": "v1",
    "total_steps": 20000,
    "batch_size": 16,
    "seq": 1024,
    "n_chunks": 2,
    "bptt_window": 2,
    "base_lr": 0.0003,
    "min_lr": 3e-05,
    "warmup_steps": 500,
    "lr_schedule": "cosine",
    "optimizer": "muon",
    "wsd_decay_frac": 0.1,
    "wsd_decay_kind": "sqrt",
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "label_smoothing": 0.0,
    "grad_clip": 1.0,
    "ckpt_every": 1000,
    "log_every": 20,
    "eval_every": 1000,
    "eval_iters": 16,
    "seed": 0,
    "use_act_ckpt": true,
    "qat_enabled": false
  }
}
