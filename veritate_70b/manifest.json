{
  "name": "Veritate 70B",
  "description": "Vanilla byte-level decoder at the 70B scale. Same canonical Veritate stack (GELU FFN, RMSNorm, learned pos-emb, tied LM head, vocab=256). Defaults enable activation checkpointing and 8-bit AdamW.",
  "kind": "trainer",
  "bench": true,
  "flow": [
    "scratch",
    "continue"
  ],
  "sizes": {
    "70b": {
      "layers": 80,
      "hidden": 8192,
      "ffn": 36864,
      "heads": 64,
      "params": 69797000000
    }
  },
  "defaults": {
    "size": "70b",
    "precision": "bf16",
    "version": "v1",
    "total_steps": 200000,
    "batch_size": 1,
    "seq": 1024,
    "n_chunks": 1,
    "bptt_window": 1,
    "base_lr": 6e-05,
    "min_lr": 6e-06,
    "warmup_steps": 8000,
    "lr_schedule": "cosine",
    "wsd_decay_frac": 0.1,
    "wsd_decay_kind": "sqrt",
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "label_smoothing": 0.0,
    "grad_clip": 1.0,
    "ckpt_every": 5000,
    "log_every": 50,
    "eval_every": 5000,
    "eval_iters": 4,
    "seed": 0,
    "use_act_ckpt": true,
    "use_8bit_adam": true,
    "qat_enabled": false
  }
}
