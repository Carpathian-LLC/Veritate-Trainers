{
  "name": "Veritate 800M",
  "description": "Vanilla byte-level decoder at the 800M scale. Same canonical Veritate stack (GELU FFN, RMSNorm, learned pos-emb, tied LM head, vocab=256). Defaults enable activation checkpointing and the Muon optimizer; batch/steps/eval cadence interpolated between the 400M and 1.3B trainers.",
  "kind": "trainer",
  "bench": true,
  "flow": [
    "scratch",
    "continue"
  ],
  "sizes": {
    "800m": {
      "layers": 28,
      "hidden": 1536,
      "ffn": 6144,
      "heads": 24,
      "params": 793000000
    }
  },
  "defaults": {
    "size": "800m",
    "precision": "bf16",
    "version": "v1",
    "total_steps": 30000,
    "batch_size": 8,
    "seq": 1024,
    "n_chunks": 2,
    "bptt_window": 2,
    "base_lr": 0.0003,
    "min_lr": 3e-05,
    "warmup_steps": 1000,
    "lr_schedule": "cosine",
    "optimizer": "muon",
    "wsd_decay_frac": 0.1,
    "wsd_decay_kind": "sqrt",
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "label_smoothing": 0.0,
    "grad_clip": 1.0,
    "ckpt_every": 1500,
    "log_every": 20,
    "eval_every": 1500,
    "eval_iters": 8,
    "seed": 0,
    "use_act_ckpt": true,
    "qat_enabled": false
  }
}
