{
  "name": "Veritate 800M",
  "description": "Vanilla byte-level decoder at the 800M scale. Same canonical Veritate stack (GELU FFN, RMSNorm, learned pos-emb, tied LM head, vocab=256). Defaults enable activation checkpointing and 8-bit AdamW.",
  "kind": "trainer",
  "bench": true,
  "flow": [
    "scratch",
    "continue"
  ],
  "sizes": {
    "800m": {
      "layers": 28,
      "hidden": 1536,
      "ffn": 6144,
      "heads": 24,
      "params": 793000000
    }
  },
  "defaults": {
    "size": "800m",
    "precision": "bf16",
    "version": "v1",
    "corpus": "fineweb_edu",
    "total_steps": 100000,
    "batch_size": 64,
    "seq": 1024,
    "n_predict": 4,
    "mtp_aux_weight": 0.1,
    "rope_base": 10000.0,
    "base_lr": 0.0003,
    "min_lr": 3e-05,
    "warmup_steps": 2000,
    "lr_schedule": "cosine",
    "wsd_decay_frac": 0.1,
    "wsd_decay_kind": "sqrt",
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "label_smoothing": 0.0,
    "grad_clip": 1.0,
    "ckpt_every": 500,
    "log_every": 20,
    "eval_every": 200,
    "eval_iters": 64,
    "seed": 0,
    "use_act_ckpt": true,
    "qat_enabled": false
  }
}
