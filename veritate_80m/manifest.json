{
  "name": "Veritate 80M (default base model)",
  "description": "Base model trainer at 80M. Vanilla byte-level decoder (vocab=256), tuned for TinyStories coherence and fast iteration. Higher peak LR, larger batch, no activation checkpointing.",
  "kind": "trainer",
  "bench": true,
  "flow": [
    "scratch",
    "continue"
  ],
  "sizes": {
    "80m": {
      "layers": 12,
      "hidden": 768,
      "ffn": 3072,
      "heads": 12,
      "params": 85000000
    },
    "120m": {
      "layers": 12,
      "hidden": 896,
      "ffn": 3584,
      "heads": 14,
      "params": 115000000
    },
    "200m": {
      "layers": 16,
      "hidden": 1024,
      "ffn": 4096,
      "heads": 16,
      "params": 202000000
    }
  },
  "defaults": {
    "size": "80m",
    "precision": "bf16",
    "version": "v1",
    "total_steps": 22000,
    "batch_size": 32,
    "seq": 256,
    "n_chunks": 96,
    "bptt_window": 8,
    "base_lr": 0.0001,
    "min_lr": 1e-06,
    "warmup_steps": 11800,
    "lr_schedule": "wsd",
    "wsd_decay_frac": 0.1,
    "wsd_decay_kind": "sqrt",
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "label_smoothing": 0.05,
    "grad_clip": 1.0,
    "ckpt_every": 200,
    "log_every": 50,
    "eval_every": 200,
    "eval_iters": 64,
    "seed": 0,
    "use_act_ckpt": false,
    "qat_enabled": true
  }
}
