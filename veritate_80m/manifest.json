{
  "name": "Veritate 80M",
  "description": "Vanilla byte-level decoder at the 80M scale. Same canonical Veritate stack (GELU FFN, RMSNorm, learned pos-emb, tied LM head, vocab=256).",
  "kind": "trainer",
  "bench": true,
  "flow": [
    "scratch",
    "continue"
  ],
  "sizes": {
    "80m": {
      "layers": 12,
      "hidden": 768,
      "ffn": 3072,
      "heads": 12,
      "params": 85000000
    }
  },
  "defaults": {
    "size": "80m",
    "precision": "bf16",
    "version": "v1",
    "total_steps": 22000,
    "batch_size": 32,
    "seq": 256,
    "n_chunks": 96,
    "bptt_window": 8,
    "base_lr": 0.0001,
    "min_lr": 1e-06,
    "warmup_steps": 11800,
    "lr_schedule": "wsd",
    "wsd_decay_frac": 0.1,
    "wsd_decay_kind": "sqrt",
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "label_smoothing": 0.05,
    "grad_clip": 1.0,
    "ckpt_every": 200,
    "log_every": 50,
    "eval_every": 200,
    "eval_iters": 64,
    "seed": 0,
    "use_act_ckpt": false,
    "qat_enabled": true
  }
}
