{
  "name": "Veritate 13B (vanilla dense)",
  "description": "Vanilla byte-level decoder in the 3B-13B range. Same canonical Veritate stack (GELU FFN, RMSNorm, learned pos-emb, tied LM head, vocab=256). Defaults enable activation checkpointing and 8-bit AdamW for memory efficiency.",
  "kind": "trainer",
  "flow": [
    "scratch",
    "continue"
  ],
  "sizes": {
    "3b":  { "layers": 32, "hidden": 2560, "ffn": 10240, "heads": 32, "params":  2516000000 },
    "7b":  { "layers": 32, "hidden": 4096, "ffn": 18432, "heads": 32, "params":  6976000000 },
    "13b": { "layers": 40, "hidden": 5120, "ffn": 21504, "heads": 40, "params": 13003000000 }
  },
  "defaults": {
    "size": "13b",
    "precision": "bf16",
    "version": "v1",
    "total_steps": 80000,
    "batch_size": 1,
    "seq": 1024,
    "n_chunks": 1,
    "bptt_window": 1,
    "base_lr": 0.00012,
    "min_lr": 1.2e-05,
    "warmup_steps": 3000,
    "lr_schedule": "cosine",
    "wsd_decay_frac": 0.1,
    "wsd_decay_kind": "sqrt",
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "label_smoothing": 0.0,
    "grad_clip": 1.0,
    "ckpt_every": 4000,
    "log_every": 25,
    "eval_every": 4000,
    "eval_iters": 4,
    "seed": 0,
    "use_act_ckpt": true,
    "use_8bit_adam": true,
    "qat_enabled": false
  }
}
