{
  "name": "Veritate 10M",
  "description": "Vanilla byte-level decoder at the 10M scale. Same canonical Veritate stack (GELU FFN, RMSNorm, learned pos-emb, tied LM head, vocab=256).",
  "kind": "trainer",
  "bench": true,
  "flow": [
    "scratch",
    "continue"
  ],
  "sizes": {
    "10m": {
      "layers": 8,
      "hidden": 320,
      "ffn": 1280,
      "heads": 8,
      "params": 10000000
    }
  },
  "defaults": {
    "size": "10m",
    "precision": "fp32",
    "version": "v1",
    "total_steps": 4000,
    "batch_size": 32,
    "seq": 512,
    "n_chunks": 4,
    "bptt_window": 4,
    "base_lr": 0.0006,
    "min_lr": 6e-05,
    "warmup_steps": 120,
    "lr_schedule": "cosine",
    "wsd_decay_frac": 0.1,
    "wsd_decay_kind": "sqrt",
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "label_smoothing": 0.0,
    "grad_clip": 1.0,
    "ckpt_every": 400,
    "log_every": 10,
    "eval_every": 100,
    "eval_iters": 8,
    "seed": 0,
    "use_act_ckpt": false,
    "qat_enabled": true
  }
}
